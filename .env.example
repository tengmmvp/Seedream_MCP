# Seedream MCP工具配置示例
# 复制此文件为 .env 并填入实际配置值
#
# 环境变量按前缀分组：
# - ARK_     火山引擎 API 相关（API 密钥、基础 URL）
# - SEEDREAM_ 服务行为与性能（模型、尺寸、超时、自动保存、流式、工作区、传输）
# - LOG_     日志（级别、文件路径）
#
# 模型能力差异（支持的尺寸档位、参考图上限、流式/组图等）以 README 能力差异表为准，
# 代码单一来源为 seedream_mcp/utils/model/model_capabilities.py。

# ================================
# 必需配置
# ================================

# 火山引擎API密钥
# 获取方式：火山引擎控制台 -> 火山方舟 -> API密钥管理
ARK_API_KEY=your_api_key_here

# ================================
# 可选配置
# ================================

# API基础URL
# 默认：https://ark.cn-beijing.volces.com/api/v3
# 必须 https；http 会使 API Key 在网络上明文传输，默认拒绝构建，
# 仅自建可信内网端点可经 SEEDREAM_ALLOW_HTTP_BASE_URL=true 豁免
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 是否豁免 http:// 的 ARK_BASE_URL
# 可选值：true, false
# 默认：false
# 说明：开启即承认 http 端点可信并接受密钥明文传输风险，仅自建可信内网使用
SEEDREAM_ALLOW_HTTP_BASE_URL=false

# 模型 ID 或模型别名
# 可选：doubao-seedream-5.0-pro / doubao-seedream-5.0 / doubao-seedream-5.0-lite / doubao-seedream-4.5 / doubao-seedream-4.0
# 说明：doubao-seedream-5.0 与 doubao-seedream-5.0-lite 为等价别名，指向同一模型
# 默认：doubao-seedream-5.0
SEEDREAM_MODEL_ID=doubao-seedream-5.0

# 默认图像尺寸
# 说明：需与所选模型兼容
# - Seedream 5.0 Pro：1K, 2K
# - Seedream 5.0 / 5.0 Lite：2K, 3K, 4K
# - Seedream 4.5：2K, 4K
# - Seedream 4.0：1K, 2K, 4K
# 默认：2K
SEEDREAM_DEFAULT_SIZE=2K

# 默认水印设置
# 可选值：true, false
# 默认：false
SEEDREAM_DEFAULT_WATERMARK=false

# 连接建立/写入/连接池获取超时（秒）；响应读取与总超时由 SEEDREAM_API_TIMEOUT 决定
# 默认：60
SEEDREAM_TIMEOUT=60

# API超时时间（秒）
# 默认：600
SEEDREAM_API_TIMEOUT=600

# API 调用最大重试次数（须 ≥ 1；429/5xx、超时、网络错误重试，4xx 不重试）
# 默认：3
SEEDREAM_MAX_RETRIES=3

# 日志级别
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认：INFO
LOG_LEVEL=INFO

# 日志文件路径
# 默认：logs/seedream_mcp.log
LOG_FILE=logs/seedream_mcp.log

# ================================
# 自动保存功能配置
# ================================

# 是否启用自动保存功能
# 可选值：true, false
# 默认：true
# 说明：启用后会自动下载生成的图片到本地，避免URL过期问题
SEEDREAM_AUTO_SAVE_ENABLED=true

# 图片保存根目录
# 默认：未设置时为 <工作区根>/images；此处示例显式指定为 ./seedream_images
# 说明：所有生成的图片将保存在此目录下，按功能类型和日期分类
SEEDREAM_AUTO_SAVE_BASE_DIR=./seedream_images

# 图片下载超时时间（秒）
# 默认：30
# 说明：单个图片下载的最大等待时间
SEEDREAM_AUTO_SAVE_DOWNLOAD_TIMEOUT=30

# 下载最大重试次数（≥ 0，0 表示不重试）
# 默认：3
# 说明：下载失败时按线性递增延迟加重试，与 API 调用的指数退避不同
SEEDREAM_AUTO_SAVE_MAX_RETRIES=3

# 最大文件大小限制（字节）
# 默认：52428800 (50MB)
# 说明：超过此大小的文件将不会被下载保存；该值另兼作流式单事件截断阈值与
# 响应体读取上限（SEEDREAM_RESPONSE_BODY_LIMIT 未设置时）的推导基准，
# 改小会同时收紧流式大图事件与响应体读取的容忍度（即使关闭自动保存也生效）
SEEDREAM_AUTO_SAVE_MAX_FILE_SIZE=52428800

# 上游响应体读取总量上限（字节）
# 默认：未设置，按 SEEDREAM_AUTO_SAVE_MAX_FILE_SIZE × 20 推导（覆盖组图 15 张
# b64_json 的合法最坏响应体）
# 说明：非流式 JSON、流式 JSON 与 SSE 三条读取路径共用此上限，超过即拒绝读取，
# 防止被污染上游倾倒巨型响应体；错误响应体另行收敛到 4MB。须为正整数。
SEEDREAM_RESPONSE_BODY_LIMIT=

# 最大并发下载数
# 默认：5
# 说明：同时进行的图片下载任务数量限制
SEEDREAM_AUTO_SAVE_MAX_CONCURRENT=5

# 是否按日期创建文件夹
# 可选值：true, false
# 默认：true
# 说明：启用后会按日期创建单层子目录（如 2026-08-12），便于文件管理
SEEDREAM_AUTO_SAVE_DATE_FOLDER=true

# 自动清理天数
# 默认：30
# 说明：自动删除指定天数前的图片文件，0表示不自动清理
SEEDREAM_AUTO_SAVE_CLEANUP_DAYS=30

# 自动保存目录总字节上限
# 默认：10737418240 (10GB)
# 说明：限制保存目录的累计占用，超过则按最旧文件优先驱逐，与按天清理互补，
# 防止保留窗口内持续写入耗尽磁盘。须为正整数。
SEEDREAM_AUTO_SAVE_MAX_TOTAL_BYTES=10737418240

# ================================
# 流式处理配置
# ================================

# 流式响应缓冲区最大大小（字节）
# 默认：10485760 (10MB)
# 说明：已消费前缀的回收阈值——缓冲区超过该值时压缩已处理部分以控制内存，
# 不用于单事件截断；单事件体积安全阀由 auto_save_max_file_size 推导，二者分工不同
SEEDREAM_STREAM_BUFFER_MAX_SIZE=10485760

# 流式响应每次读取的块大小（字节）
# 默认：1048576 (1MB)
# 说明：流式处理时每次读取的数据块大小，影响内存使用和处理效率
SEEDREAM_STREAM_CHUNK_SIZE=1048576

# ================================
# 客户端性能配置
# ================================

# 图像预处理并发上限
# 默认：5
# 说明：图生图/多图融合读取本地参考图的并发数，机械硬盘建议调低
SEEDREAM_IMAGE_PREPARE_CONCURRENCY=5

# 参考图预处理结果缓存上限（LRU 条目数）
# 默认：32
# 说明：图生图/多图融合参考图读取结果的缓存数量，超过按 LRU 淘汰最久未用条目
SEEDREAM_PREPARE_CACHE_MAX=32

# 参考图预处理结果缓存的累计字节上限
# 默认：268435456 (256MB)
# 说明：限制参考图预处理缓存占用的总内存，大图场景按需调高，须为正整数
SEEDREAM_PREPARE_CACHE_MAX_BYTES=268435456

# ================================
# 工作区与传输配置
# ================================

# 本地文件访问工作区根目录
# 说明：本地开发（未配置 MCP Roots）时作为图片文件读写的边界回退目录。
# 未设置时回退到当前工作目录。MCP 客户端配置了 Roots 时优先使用 Roots。
SEEDREAM_WORKSPACE_ROOT=

# streamable-http 传输的 Bearer 鉴权令牌
# 说明：以 streamable-http 暴露到非回环地址时必须配置，否则服务拒绝启动（另需 TLS
# 或 --insecure-allow-non-tls 豁免）；客户端需在 Authorization 头携带相同令牌。
# stdio 传输不需要此项。
SEEDREAM_HTTP_AUTH_TOKEN=

# streamable-http 请求体大小上限（字节）
# 默认：67108864 (64MB)
# 说明：按 Content-Length 早拒超大请求体，防止已认证客户端提交 GB 级 prompt/data URI
# 导致 OOM。MCP 正常载荷远小于 100MB，单图 data URI 上限约 40MB，默认 64MB 兼顾
# 多图融合。不能低于 1MB（1048576），低于则配置构建失败。大体量场景若超此值应分批或调高。
SEEDREAM_HTTP_MAX_BODY_SIZE=67108864
